# Copy this file to .env (gitignored) and fill in the keys you need.
# - ANTHROPIC_API_KEY: proprietary generator (claude-haiku-4-5)
# - GROQ_API_KEY:      open-source generator (llama-3.1-8b-instant via Groq)
# - OPENAI_API_KEY:    DeepEval judge (gpt-4.1, default)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# DeepEval judge via an OpenAI-compatible gpt-oss-120b host (used for the r3 runs;
# replaces the waitlisted Groq pay-per-token tier). Set --judge compat:openai/gpt-oss-120b
# (or JUDGE_MODEL=compat:openai/gpt-oss-120b) and provide a key + matching base_url below.
# JUDGE_MODEL=compat:openai/gpt-oss-120b
# JUDGE_BASE_URL=https://api.deepinfra.com/v1/openai   # DeepInfra (cheapest; default in config_api.py)
# JUDGE_BASE_URL=https://api.together.xyz/v1           # Together (model: openai/gpt-oss-120b)
# JUDGE_BASE_URL=https://api.fireworks.ai/inference/v1 # Fireworks (model: accounts/fireworks/models/gpt-oss-120b)
JUDGE_API_KEY=

# Optional overrides (defaults shown)
# ANTHROPIC_GENERATOR_MODEL=claude-haiku-4-5
# OPENSOURCE_GENERATOR_MODEL=llama-3.1-8b-instant
# OPENSOURCE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL=gpt-4.1
